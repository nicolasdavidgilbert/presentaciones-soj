---
import Slide from '../components/presentation/Slide.astro';
import Icon from '../components/Icon.astro';
import { Leaf, Coins, Users } from 'lucide';
import { pillars } from '../data/content';

const icons = { ambiental: Leaf, economica: Coins, social: Users };
---

<Slide theme="paper" title="2. Tipos de sostenibilidad">
  <div class="absolute inset-37.5 flex flex-col">
    <div class="flex items-end justify-between">
      <div>
        <p class="kicker" data-a="fade">02 · Los tres pilares</p>
        <h2 class="title text-[90px] mt-4" data-a="words">Sostenibilidad <em>en tres dimensiones</em></h2>
      </div>
    </div>
    <div class="grid grid-cols-3 gap-11 mt-auto pt-8.5">
      {pillars.map((p, i) => (
        <article class="card p-10 pt-8.5 flex flex-col" data-a="up">
          <div class="flex items-center justify-between">
            <span class="grid place-items-center size-20 rounded-full bg-forest text-paper"><Icon icon={icons[p.key]} size={40} /></span>
            <span class="font-display text-[64px] text-forest/25">0{i + 1}</span>
          </div>
          <h3 class="font-serif text-[62px] mt-5 leading-none">{p.title}</h3>
          <p class="text-[22px] leading-[1.4] mt-3.5 opacity-85">{p.text}</p>
          <ul class="mt-6.5 pt-5.5 border-t border-ink/20 space-y-3.5">
            {p.examples.map((e) => (
              <li class="flex gap-3.5 text-[22px] leading-snug">
                <span class="mt-2.5 size-2.25 shrink-0 rounded-full bg-forest"></span>{e}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</Slide>
