---
import Slide from '../components/presentation/Slide.astro';
import Icon from '../components/Icon.astro';
import { Briefcase, Handshake, Siren, Megaphone, Vote, RefreshCw } from 'lucide';
import { sgFunctions } from '../data/content';

const icons = [Briefcase, Handshake, Siren, Megaphone];
---

<Slide theme="forest" title="5. Secretario general">
  <div class="absolute inset-37.5 flex flex-col">
    <p class="kicker" data-a="fade">05 · El cargo</p>
    <h2 class="title text-[100px] mt-4" data-a="words">El secretario general <em>de la ONU</em></h2>

    <div class="grid grid-cols-[1.25fr_1fr] gap-12.5 mt-auto">
      <section>
        <h3 class="font-serif italic text-[40px] text-leaf" data-a="fade">a) ¿Cuál es su función principal?</h3>
        <div class="grid grid-cols-2 gap-6 mt-6">
          {sgFunctions.map((f, i) => (
            <article class="card p-7.5" data-a="up">
              <div class="flex items-center gap-4">
                <Icon icon={icons[i]} size={34} class="text-sun shrink-0" />
                <h4 class="font-serif text-[36px] leading-none">{f.title}</h4>
              </div>
              <p class="text-[21px] leading-[1.45] mt-3.5 opacity-85">{f.text}</p>
            </article>
          ))}
        </div>
      </section>
      <section class="flex flex-col gap-6">
        <article class="card p-9 flex-1" data-a="right">
          <div class="flex items-center gap-4">
            <Icon icon={Vote} size={34} class="text-sun" />
            <h3 class="font-serif italic text-[36px] text-leaf leading-none">b) ¿Quién lo elige? ¿Cuánto tiempo?</h3>
          </div>
          <p class="text-[24px] leading-[1.45] mt-4.5">
            La <strong>Asamblea General</strong>, a recomendación del <strong>Consejo de Seguridad</strong>.
          </p>
          <p class="mt-3.5 flex items-baseline gap-4">
            <span class="font-display text-[86px] text-sun leading-none" data-count="5">5</span>
            <span class="font-serif text-[34px]">años, renovables</span>
          </p>
        </article>
        <article class="card p-9 flex-1" data-a="right">
          <div class="flex items-center gap-4">
            <Icon icon={RefreshCw} size={34} class="text-sun" />
            <h3 class="font-serif italic text-[36px] text-leaf leading-none">c) ¿Puede ser reelegido?</h3>
          </div>
          <p class="text-[24px] leading-[1.45] mt-4.5">
            <strong class="text-sun">Sí.</strong> La Carta no fija un límite de mandatos, pero por tradición nadie ha superado <strong>dos (10 años)</strong>. António Guterres está en su segundo mandato.
          </p>
        </article>
      </section>
    </div>
  </div>
</Slide>
