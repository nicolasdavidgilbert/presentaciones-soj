---
import '../styles/global.css';
import ProgressBar from '../components/presentation/ProgressBar.astro';
import Navigation from '../components/presentation/Navigation.astro';
import Overview from '../components/presentation/Overview.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Presentación: sostenibilidad y desarrollo sostenible — 2º ASIR" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <canvas id="scene" aria-hidden="true"></canvas>
    <main class="stage">
      <slot />
    </main>
    <ProgressBar />
    <Navigation />
    <Overview />
    <script>
      import { initPresentation } from '../scripts/presentation';
      initPresentation();
    </script>
  </body>
</html>
