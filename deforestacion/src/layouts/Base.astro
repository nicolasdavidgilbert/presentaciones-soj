---
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><path d='M16 2 6 16h5l-6 9h9v5h4v-5h9l-6-9h5z' fill='%23a6c48a'/></svg>" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
